using System;

namespace BibliotecaApp.Utils.Dtos
{
    /// <summary>
    /// Encapsula os dados para envio de e-mail via API central.
    /// </summary>
    public class EmailRequest
    {
        public string EscolaId { get; set; }
        public string Remetente { get; set; }
        public string Destinatario { get; set; }
        public string Assunto { get; set; }
        public string Mensagem { get; set; }

        /// <summary>
        /// Conteúdo do anexo em Base64. Opcional.
        /// </summary>
        public string AnexoBase64 { get; set; }

        /// <summary>
        /// Nome do arquivo anexado (sem caminho). Opcional.
        /// </summary>
        public string NomeAnexo { get; set; }
    }
}