using BibliotecaApp.Models;
using BibliotecaApp.Utils;
using System;
using System.Data;
using System.Data.SqlServerCe;
using System.Drawing;
using System.IO;
using System.Security.Cryptography;
using System.Net.Mail;
using System.Windows.Forms;

namespace BibliotecaApp.Forms.Setup
{
    public class PrimeiroUsoForm : Form
    {
        private readonly TextBox _nomeInstituicao = Campo();
        private readonly TextBox _logoPath = Campo();
        private readonly ComboBox _tema = new ComboBox();
        private readonly Panel _visualizadorCor = new Panel();
        private readonly TextBox _nomeBibliotecaria = Campo();
        private readonly TextBox _emailBibliotecaria = Campo();
        private readonly TextBox _telefoneBibliotecaria = Campo();
        private readonly TextBox _senhaBibliotecaria = Campo(true);
        private readonly TextBox _confirmarSenhaBibliotecaria = Campo(true);
        private readonly TextBox _codigoMestre = Campo();
        private readonly string _codigoMestreGerado = GerarCodigoMestre();
        private string _caminhoCodigoMestre;

        public PrimeiroUsoForm()
        {
            Text = "Configuração inicial da instituição";
            StartPosition = FormStartPosition.CenterScreen;
            FormBorderStyle = FormBorderStyle.FixedDialog;
            MaximizeBox = false;
            MinimizeBox = false;
            ClientSize = new Size(560, 720);

            var titulo = new Label
            {
                Text = "Configure a biblioteca para sua instituição",
                Font = new Font("Segoe UI", 14, FontStyle.Bold),
                Location = new Point(24, 18),
                Size = new Size(510, 32)
            };
            Controls.Add(titulo);

            int y = 66;
            AdicionarCampo("Nome da instituição *", _nomeInstituicao, ref y);
            AdicionarCampo("Logo (opcional)", _logoPath, ref y);
            var procurarLogo = new Button { Text = "Procurar", Location = new Point(444, y - 31), Size = new Size(84, 28) };
            procurarLogo.Click += ProcurarLogo_Click;
            Controls.Add(procurarLogo);
            Controls.Add(new Label { Text = "Tema da interface *", Location = new Point(26, y), Size = new Size(380, 18) });
            _tema.DropDownStyle = ComboBoxStyle.DropDownList;
            _tema.Location = new Point(26, y + 20);
            _tema.Size = new Size(250, 28);
            foreach (var preset in ThemeManager.Presets)
                _tema.Items.Add(preset);
            _tema.SelectedIndex = 0;
            _visualizadorCor.BorderStyle = BorderStyle.FixedSingle;
            _visualizadorCor.Location = new Point(290, y + 20);
            _visualizadorCor.Size = new Size(48, 28);
            _visualizadorCor.BackColor = ((ThemePreset)_tema.SelectedItem).PrimaryColor;
            Controls.Add(_visualizadorCor);
            _tema.SelectedIndexChanged += Tema_SelectedIndexChanged;
            y += 52;
            AdicionarCampo("Nome da primeira bibliotecária *", _nomeBibliotecaria, ref y);
            AdicionarCampo("E-mail para login *", _emailBibliotecaria, ref y);
            AdicionarCampo("Telefone *", _telefoneBibliotecaria, ref y);
            AdicionarCampo("Senha (mínimo 8 caracteres) *", _senhaBibliotecaria, ref y);
            AdicionarCampo("Confirme a senha *", _confirmarSenhaBibliotecaria, ref y);

            Controls.Add(new Label
            {
                Text = "Código-mestre gerado automaticamente. Exporte e guarde fora deste computador:",
                Location = new Point(26, y),
                Size = new Size(505, 18)
            });
            _codigoMestre.ReadOnly = true;
            _codigoMestre.Text = _codigoMestreGerado;
            _codigoMestre.Location = new Point(26, y + 20);
            _codigoMestre.Width = 360;
            Controls.Add(_codigoMestre);
            var exportarCodigo = new Button { Text = "Salvar arquivo...", Location = new Point(396, y + 18), Size = new Size(132, 28) };
            exportarCodigo.Click += ExportarCodigo_Click;
            Controls.Add(exportarCodigo);
            var statusCodigo = new Label { Name = "statusCodigo", Text = "Ainda não exportado", Location = new Point(26, y + 50), Size = new Size(500, 18), ForeColor = Color.DarkRed };
            Controls.Add(statusCodigo);

            var salvar = new Button
            {
                Text = "Concluir configuração",
                Location = new Point(328, 672),
                Size = new Size(200, 32),
                DialogResult = DialogResult.None
            };
            salvar.Click += Salvar_Click;
            Controls.Add(salvar);
            AcceptButton = salvar;

        }



        private static TextBox Campo(bool senha = false)
        {
            return new TextBox { Width = 330, UseSystemPasswordChar = senha };
        }

        private void AdicionarCampo(string rotulo, TextBox campo, ref int y)
        {
            Controls.Add(new Label { Text = rotulo, Location = new Point(26, y), Size = new Size(380, 18) });
            campo.Location = new Point(26, y + 20);
            Controls.Add(campo);
            y += 52;
        }

        private void ProcurarLogo_Click(object sender, EventArgs e)
        {
            using (var dialogo = new OpenFileDialog
            {
                Filter = "Imagens|*.png;*.jpg;*.jpeg;*.bmp",
                Title = "Selecione o logo da instituição"
            })
            {
                if (dialogo.ShowDialog(this) == DialogResult.OK)
                    _logoPath.Text = dialogo.FileName;
            }
        }

        private void Tema_SelectedIndexChanged(object sender, EventArgs e)
        {
            var tema = _tema.SelectedItem as ThemePreset;
            if (tema != null)
                _visualizadorCor.BackColor = tema.PrimaryColor;
        }

        private void ExportarCodigo_Click(object sender, EventArgs e)
        {
            using (var dialogo = new SaveFileDialog
            {
                Filter = "Arquivo de texto|*.txt",
                FileName = "codigo-mestre-biblioteca.txt",
                Title = "Exporte o código-mestre para armazenamento institucional"
            })
            {
                if (dialogo.ShowDialog(this) != DialogResult.OK)
                    return;

                try
                {
                    File.WriteAllText(dialogo.FileName, "Código-mestre da instituição: " + _codigoMestreGerado);
                    _caminhoCodigoMestre = dialogo.FileName;
                    var status = Controls["statusCodigo"] as Label;
                    if (status != null)
                    {
                        status.Text = "Exportado para: " + _caminhoCodigoMestre;
                        status.ForeColor = Color.DarkGreen;
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show(this, "Não foi possível exportar o código-mestre: " + ex.Message, "Erro de exportação",
                        MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }

        private static string GerarCodigoMestre()
        {
            var bytes = new byte[24];
            using (var gerador = RandomNumberGenerator.Create())
                gerador.GetBytes(bytes);

            return BitConverter.ToString(bytes).Replace("-", string.Empty);
        }

        private void Salvar_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(_nomeInstituicao.Text) ||
                string.IsNullOrWhiteSpace(_nomeBibliotecaria.Text) ||
                string.IsNullOrWhiteSpace(_emailBibliotecaria.Text) ||
                string.IsNullOrWhiteSpace(_telefoneBibliotecaria.Text) ||
                string.IsNullOrWhiteSpace(_senhaBibliotecaria.Text))
            {
                MessageBox.Show(this, "Preencha todos os campos obrigatórios.", "Configuração incompleta",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string email = _emailBibliotecaria.Text.Trim();
            if (!EmailValido(email))
            {
                MessageBox.Show(this, "Informe um endereço de e-mail válido para a bibliotecária.", "E-mail inválido",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                _emailBibliotecaria.Focus();
                return;
            }

            if (_senhaBibliotecaria.Text != _confirmarSenhaBibliotecaria.Text)
            {
                MessageBox.Show(this, "A confirmação da senha deve ser igual à senha informada.", "Verifique os dados",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (_senhaBibliotecaria.Text.Length < 8)
            {
                MessageBox.Show(this, "A senha deve ter pelo menos 8 caracteres.", "Senha fraca",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string telefone = new string(_telefoneBibliotecaria.Text.Where(char.IsDigit).ToArray());
            if (telefone.Length < 11 || telefone.Length > 12)
            {
                MessageBox.Show(this, "Informe um telefone válido com DDD.", "Telefone inválido",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                _telefoneBibliotecaria.Focus();
                return;
            }

            if (string.IsNullOrWhiteSpace(_caminhoCodigoMestre) || !File.Exists(_caminhoCodigoMestre))
            {
                MessageBox.Show(this, "Exporte o código-mestre para um local externo antes de concluir a configuração.", "Código-mestre não exportado",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string logoPath = _logoPath.Text.Trim();
            if (!string.IsNullOrEmpty(logoPath) && !File.Exists(logoPath))
            {
                MessageBox.Show(this, "O arquivo de logo selecionado não existe.", "Logo inválido",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var tema = _tema.SelectedItem as ThemePreset;
            if (tema == null)
                return;

            CriptografiaSenha.CriarHash(_senhaBibliotecaria.Text, out string senhaHash, out string senhaSalt);
            CriptografiaSenha.CriarHash(_codigoMestreGerado, out string codigoHash, out string codigoSalt);

            try
            {
                using (SqlCeConnection conexao = Conexao.ObterConexao())
                {
                    conexao.Open();
                    using (SqlCeTransaction transacao = conexao.BeginTransaction())
                    {
                        using (SqlCeCommand verificarEmail = conexao.CreateCommand())
                        {
                            verificarEmail.Transaction = transacao;
                            verificarEmail.CommandText = "SELECT COUNT(*) FROM usuarios WHERE Email = @Email";
                            verificarEmail.Parameters.AddWithValue("@Email", email);
                            if (Convert.ToInt32(verificarEmail.ExecuteScalar()) > 0)
                            {
                                MessageBox.Show(this, "Este e-mail já está cadastrado no sistema.", "E-mail em uso",
                                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                                _emailBibliotecaria.Focus();
                                return;
                            }
                        }

                        using (SqlCeCommand inserir = conexao.CreateCommand())
                        {
                            inserir.Transaction = transacao;
                            inserir.CommandText = @"INSERT INTO usuarios
(Nome, Email, Senha_Hash, Senha_Salt, CPF, DataNascimento, Turma, Telefone, TipoUsuario)
VALUES
(@Nome, @Email, @Senha_Hash, @Senha_Salt, @CPF, @DataNascimento, @Turma, @Telefone, @TipoUsuario)";
                            inserir.Parameters.AddWithValue("@Nome", _nomeBibliotecaria.Text.Trim());
                            inserir.Parameters.AddWithValue("@Email", email);
                            inserir.Parameters.AddWithValue("@Senha_Hash", senhaHash);
                            inserir.Parameters.AddWithValue("@Senha_Salt", senhaSalt);
                            inserir.Parameters.AddWithValue("@CPF", DBNull.Value);
                            inserir.Parameters.AddWithValue("@DataNascimento", DateTime.Today);
                            inserir.Parameters.AddWithValue("@Turma", DBNull.Value);
                            inserir.Parameters.AddWithValue("@Telefone", _telefoneBibliotecaria.Text.Trim());
                            inserir.Parameters.AddWithValue("@TipoUsuario", "Bibliotecário(a)");
                            inserir.ExecuteNonQuery();
                        }

                        InstituicaoConfiguracaoStore.Salvar(new InstituicaoConfiguracao
                        {
                            Nome = _nomeInstituicao.Text.Trim(),
                            LogoPath = string.IsNullOrEmpty(logoPath) ? null : logoPath,
                            CorPrimaria = ColorTranslator.ToHtml(tema.PrimaryColor),
                            CodigoMestreHash = codigoHash,
                            CodigoMestreSalt = codigoSalt
                        });

                        transacao.Commit();
                    }
                }

                DialogResult = DialogResult.OK;
                Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show(this, "Não foi possível salvar a configuração: " + ex.Message, "Erro",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private static bool EmailValido(string email)
        {
            try
            {
                var endereco = new MailAddress(email);
                return string.Equals(endereco.Address, email, StringComparison.OrdinalIgnoreCase);
            }
            catch (FormatException)
            {
                return false;
            }
        }
    }
}