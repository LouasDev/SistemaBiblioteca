root = true

[*.cs]

# Suprimir regras de nomenclatura para WinForms (IDE1006)
dotnet_naming_rule_private_fields_should_be_camel_case.severity = none
dotnet_naming_rule_private_methods.severity = none
dotnet_diagnostic.IDE1006.severity = suggestion

# Sugestões (não bloquear)
dotnet_diagnostic.IDE0044.severity = suggestion
dotnet_diagnostic.IDE0017.severity = suggestion
dotnet_diagnostic.IDE0019.severity = suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0059.severity = suggestion
dotnet_diagnostic.IDE0040.severity = suggestion

# Regras de análise de código da Microsoft
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA2007.severity = suggestion
