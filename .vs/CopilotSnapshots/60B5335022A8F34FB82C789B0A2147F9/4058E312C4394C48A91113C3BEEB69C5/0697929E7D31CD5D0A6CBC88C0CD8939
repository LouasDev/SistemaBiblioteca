using BibliotecaApp.Models;
using BibliotecaApp.Utils;
using System;
using System.Drawing;
using System.IO;
using System.Net.Mail;
using System.Windows.Forms;

namespace BibliotecaApp.Forms.Setup
{
    public class PrimeiroUsoForm : Form
    {
        private readonly TextBox _nomeInstituicao = Campo();
        private readonly TextBox _logoPath = Campo();
        private readonly TextBox _corPrimaria = Campo();
        private readonly TextBox _emailAdministrador = Campo();
        private readonly TextBox _senhaAdministrador = Campo(true);
        private readonly TextBox _confirmarSenhaAdministrador = Campo(true);
        private readonly TextBox _codigoMestre = Campo(true);
        private readonly TextBox _confirmarCodigoMestre = Campo(true);

        public PrimeiroUsoForm()
        {
            Text = "Configuração inicial da instituição";
            StartPosition = FormStartPosition.CenterScreen;
            FormBorderStyle = FormBorderStyle.FixedDialog;
            MaximizeBox = false;
            MinimizeBox = false;
            ClientSize = new Size(540, 530);

            var titulo = new Label
            {
                Text = "Configure a biblioteca para sua instituição",
                Font = new Font("Segoe UI", 14, FontStyle.Bold),
                Location = new Point(24, 18),
                Size = new Size(490, 32)
            };
            Controls.Add(titulo);

            int y = 66;
            AdicionarCampo("Nome da instituição *", _nomeInstituicao, ref y);
            AdicionarCampo("Logo (opcional)", _logoPath, ref y);
            var procurarLogo = new Button { Text = "Procurar", Location = new Point(430, y - 31), Size = new Size(84, 28) };
            procurarLogo.Click += ProcurarLogo_Click;
            Controls.Add(procurarLogo);
            AdicionarCampo("Cor principal (HEX)", _corPrimaria, ref y);
            _corPrimaria.Text = "#1F487E";
            AdicionarCampo("E-mail do administrador *", _emailAdministrador, ref y);
            AdicionarCampo("Senha do administrador *", _senhaAdministrador, ref y);
            AdicionarCampo("Confirme a senha *", _confirmarSenhaAdministrador, ref y);
            AdicionarCampo("Código-mestre *", _codigoMestre, ref y);
            AdicionarCampo("Confirme o código-mestre *", _confirmarCodigoMestre, ref y);

            var salvar = new Button
            {
                Text = "Concluir configuração",
                Location = new Point(318, 480),
                Size = new Size(196, 32),
                DialogResult = DialogResult.None
            };
            salvar.Click += Salvar_Click;
            Controls.Add(salvar);
            AcceptButton = salvar;

        }



        private static TextBox Campo(bool senha = false)
        {
            return new TextBox { Width = 330, UseSystemPasswordChar = senha };
        }

        private void AdicionarCampo(string rotulo, TextBox campo, ref int y)
        {
            Controls.Add(new Label { Text = rotulo, Location = new Point(26, y), Size = new Size(380, 18) });
            campo.Location = new Point(26, y + 20);
            Controls.Add(campo);
            y += 52;
        }

        private void ProcurarLogo_Click(object sender, EventArgs e)
        {
            using (var dialogo = new OpenFileDialog
            {
                Filter = "Imagens|*.png;*.jpg;*.jpeg;*.bmp",
                Title = "Selecione o logo da instituição"
            })
            {
                if (dialogo.ShowDialog(this) == DialogResult.OK)
                    _logoPath.Text = dialogo.FileName;
            }
        }

        private void Salvar_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(_nomeInstituicao.Text) ||
                string.IsNullOrWhiteSpace(_emailAdministrador.Text) ||
                string.IsNullOrWhiteSpace(_senhaAdministrador.Text) ||
                string.IsNullOrWhiteSpace(_codigoMestre.Text))
            {
                MessageBox.Show(this, "Preencha todos os campos obrigatórios.", "Configuração incompleta",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string emailAdministrador = _emailAdministrador.Text.Trim();
            if (!EmailValido(emailAdministrador))
            {
                MessageBox.Show(this, "Informe um endereço de e-mail válido para o administrador.", "E-mail inválido",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                _emailAdministrador.Focus();
                return;
            }

            if (_senhaAdministrador.Text != _confirmarSenhaAdministrador.Text ||
                _codigoMestre.Text != _confirmarCodigoMestre.Text)
            {
                MessageBox.Show(this, "As confirmações de senha e código-mestre devem ser iguais.", "Verifique os dados",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (_senhaAdministrador.Text.Length < 8 || _codigoMestre.Text.Length < 8)
            {
                MessageBox.Show(this, "A senha e o código-mestre devem ter pelo menos 8 caracteres.", "Credenciais fracas",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            Color cor;
            try
            {
                cor = ColorTranslator.FromHtml(_corPrimaria.Text.Trim());
                if (cor.IsEmpty)
                    throw new FormatException();
            }
            catch
            {
                MessageBox.Show(this, "Informe uma cor HEX válida, por exemplo #1F487E.", "Cor inválida",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string logoPath = _logoPath.Text.Trim();
            if (!string.IsNullOrEmpty(logoPath) && !File.Exists(logoPath))
            {
                MessageBox.Show(this, "O arquivo de logo selecionado não existe.", "Logo inválido",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            CriptografiaSenha.CriarHash(_senhaAdministrador.Text, out string senhaHash, out string senhaSalt);
            CriptografiaSenha.CriarHash(_codigoMestre.Text, out string codigoHash, out string codigoSalt);

            try
            {
                InstituicaoConfiguracaoStore.Salvar(new InstituicaoConfiguracao
                {
                    Nome = _nomeInstituicao.Text.Trim(),
                    LogoPath = string.IsNullOrEmpty(logoPath) ? null : logoPath,
                    CorPrimaria = ColorTranslator.ToHtml(cor),
                    EmailAdministrador = emailAdministrador,
                    SenhaAdministradorHash = senhaHash,
                    SenhaAdministradorSalt = senhaSalt,
                    CodigoMestreHash = codigoHash,
                    CodigoMestreSalt = codigoSalt
                });

                DialogResult = DialogResult.OK;
                Close();
            }

        private static bool EmailValido(string email)
        {
            try
            {
                var endereco = new MailAddress(email);
                return string.Equals(endereco.Address, email, StringComparison.OrdinalIgnoreCase);
            }
            catch (FormatException)
            {
                return false;
            }
        }
            catch (Exception ex)
            {
                MessageBox.Show(this, "Não foi possível salvar a configuração: " + ex.Message, "Erro",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
}