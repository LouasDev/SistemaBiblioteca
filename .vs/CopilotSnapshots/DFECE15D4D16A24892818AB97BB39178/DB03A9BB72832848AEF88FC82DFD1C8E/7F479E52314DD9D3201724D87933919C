        private void CriarErro(Control controle)
        {
            var erro = CriarLabel("erro_" + controle.Name, string.Empty, 0, 0, 430, 18, 8.5f, FontStyle.Regular);
            erro.ForeColor = Color.Firebrick;
            erro.Visible = false;
            _erros[controle] = erro;
        }

        private void LimparErros()
        {
            foreach (var erro in _erros.Values)
            {
                erro.Text = string.Empty;
                erro.Visible = false;
            }
        }

        private bool MostrarErro(Control controle, string mensagem)
        {
            Label erro;
            if (!_erros.TryGetValue(controle, out erro))
                return false;

            erro.Text = mensagem;
            erro.Location = new Point(controle.Left, controle.Bottom + 2);
            erro.Size = new Size(Math.Max(200, controle.Width), 18);
            erro.Visible = true;
            controle.Focus();
            return false;
        }

        private bool ValidarEtapa1()
        {
            LimparErros();
            bool valido = true;

            if (string.IsNullOrWhiteSpace(_nomeInstituicao.Text))
                valido = MostrarErro(_nomeInstituicao, "Informe o nome da instituição.") && valido;

            if (_tema.SelectedItem == null)
                valido = MostrarErro(_tema, "Selecione um tema para o sistema.") && valido;

            return valido;
        }

        private bool ValidarEtapa2()
        {
            LimparErros();
            bool valido = true;
            string email = _emailBibliotecaria.Text.Trim();
            string telefone = new string(Array.FindAll(_telefoneBibliotecaria.Text.ToCharArray(), char.IsDigit));

            if (string.IsNullOrWhiteSpace(_nomeBibliotecaria.Text))
                valido = MostrarErro(_nomeBibliotecaria, "Informe o nome da bibliotecária.") && valido;
            if (string.IsNullOrWhiteSpace(email) || !EmailValido(email))
                valido = MostrarErro(_emailBibliotecaria, "Informe um endereço de e-mail válido.") && valido;
            if (telefone.Length < 11 || telefone.Length > 12)
                valido = MostrarErro(_telefoneBibliotecaria, "Informe um telefone válido com DDD.") && valido;
            if (_senhaBibliotecaria.Text.Length < 6 || _senhaBibliotecaria.Text.Length > 25)
                valido = MostrarErro(_senhaBibliotecaria, "A senha deve ter entre 6 e 25 caracteres.") && valido;
            if (_senhaBibliotecaria.Text != _confirmarSenhaBibliotecaria.Text)
                valido = MostrarErro(_confirmarSenhaBibliotecaria, "As senhas informadas não coincidem.") && valido;
            if (string.IsNullOrWhiteSpace(_caminhoCodigoMestre) || !File.Exists(_caminhoCodigoMestre))
            {
                _mensagemCodigo.Text = "Pendente de salvamento";
                _mensagemCodigo.ForeColor = ThemeManager.Darken(((ThemePreset)_tema.SelectedItem).PrimaryColor, 0.4f);
                valido = false;
            }

            return valido;
        }

